{
  "openapi": "3.1.0",
  "info": {
    "title": "SEO Skills AI Actions API",
    "description": "Schema for a hypothetical GPT Actions HTTP API. This Python repository does not host https://api.seoskillsai.com. Use scripts/mcp_server.py (stdio) or python scripts/full_audit.py locally.",
    "version": "1.2.0",
    "x-not-shipped": true
  },
  "servers": [
    {
      "url": "http://127.0.0.1/not-shipped",
      "description": "Not shipped. No public REST API is published with this repo."
    }
  ],
  "paths": {
    "/audit": {
      "post": {
        "summary": "Run full-site or single-page AI SEO audit",
        "operationId": "runSeoAudit",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string",
                    "format": "uri",
                    "description": "Target website URL to audit"
                  },
                  "categories": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Specific SEO audit disciplines to evaluate"
                  }
                },
                "required": ["url"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Comprehensive prioritized audit report with health score",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "healthScore": { "type": "number" },
                    "criticalIssues": { "type": "array", "items": { "type": "string" } },
                    "actionPlan": { "type": "array", "items": { "type": "string" } }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
